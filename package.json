{
  "name": "busybar-slot-machine",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Slot Machine JavaScript app for BUSY Bar",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "COPYFILE_DISABLE=1 busy-cli build --emit both --bundle",
    "test": "node --test tests/*.test.js",
    "app:install": "busy-cli app install",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop"
  },
  "dependencies": {
    "@busy-app/busy-lib": "0.21.1"
  },
  "devDependencies": {
    "@busy-app/cli": "0.6.0",
    "typescript": "6.0.3"
  }
}
